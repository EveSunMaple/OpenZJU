---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/presentation/layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在" noindex>
  <div class="page-shell">
    <section class="not-found" aria-labelledby="not-found-title">
      <span class="not-found__code">404 / COORDINATE LOST</span>
      <h1 id="not-found-title">这个坐标上<br>没有项目。</h1>
      <p>这个地址没有对应的页面，链接可能已经变化。回到索引页重新查找。</p>
      <a class="btn btn--primary" href="/">
        返回全部项目
        <Icon name="lucide:arrow-right" aria-hidden="true" />
      </a>
    </section>
  </div>
</BaseLayout>
