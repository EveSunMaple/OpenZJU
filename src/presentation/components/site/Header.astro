---
import { CATEGORIES } from "@/domain/project/category";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const links = [
  { href: "/", label: "全部", active: pathname === "/" },
  ...CATEGORIES.map((category) => ({
    href: `/categories/${category.id}/`,
    label: category.label,
    active: pathname === `/categories/${category.id}`,
  })),
  { href: "/about/", label: "关于", active: pathname === "/about" },
];
---

<header class="site-header">
  <div class="page-shell site-header__inner">
    <div class="site-header__left">
      <Logo />
    </div>

    <nav class="site-nav" aria-label="主导航">
      {links.map((link) => (
        <a class="site-nav__link" href={link.href} aria-current={link.active ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="site-header__right">
      <ThemeToggle />
    </div>
  </div>
</header>
