---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config/site";
import { CATEGORIES } from "@/domain/project/category";
import { formatDateTime } from "@/presentation/lib/format";
import Logo from "./Logo.astro";

interface Props {
  syncedAt?: string | null;
  source?: string | null;
  total?: number;
}

const { syncedAt, source, total } = Astro.props;
const year = new Date().getFullYear();

const sourceLabels: Record<string, string> = {
  "github-graphql": "GitHub GraphQL",
  "github-rest": "GitHub REST / Atom",
  mixed: "GitHub + 本地缓存",
  cache: "本地缓存",
};
---

<footer class="site-footer">
  <div class="page-shell">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo />
        <p class="site-footer__tagline">
          一个由社区维护的浙江大学开源项目索引。做新项目之前，先看看有没有人已经做过；使用项目之前，先看看它是否仍在维护。
        </p>
      </div>

      <nav class="site-footer__nav" aria-label="页脚导航">
        {CATEGORIES.map((category) => <a href={`/categories/${category.id}/`}>{category.label}</a>)}
        <a href="/about/">关于</a>
        <a href="/about/#criteria">收录标准</a>
        <a href="/about/#contribute">贡献项目</a>
        {siteConfig.repositoryUrl && (
          <a href={siteConfig.repositoryUrl} target="_blank" rel="noopener noreferrer">
            GitHub
            <Icon name="lucide:arrow-up-right" aria-hidden="true" />
          </a>
        )}
      </nav>
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__meta">
        <span>
          © {year} {siteConfig.name} ·
          <a
            href="https://www.gnu.org/licenses/gpl-3.0.html"
            target="_blank"
            rel="noopener noreferrer"
          >
            GPL-3.0
          </a>
        </span>
        {total !== undefined && <span>收录 {total} 个项目</span>}
      </div>

      <div class="site-footer__meta">
        {source && <span>数据源：{sourceLabels[source] ?? source}</span>}
        {syncedAt && <span>数据同步于 {formatDateTime(syncedAt)}</span>}
        <span>非官方项目索引，项目版权归各自作者所有</span>
      </div>
    </div>
  </div>
</footer>
