---
import { Icon } from "astro-icon/components";
import type { ProjectView } from "@/application/catalog";
import { normalizeSearchText } from "@/application/search";
import { formatCommitFrequency, formatCompactNumber, formatDate } from "@/presentation/lib/format";
import AuditBadge from "./AuditBadge.astro";
import ProjectAvatar from "./ProjectAvatar.astro";

interface Props {
  project: ProjectView;
}

const { project } = Astro.props;
const { stats, audit, maintenance, categoryInfo, links } = project;

const primaryHref = links.website ?? links.download ?? project.repoUrl ?? "#";
const hasWebsite = Boolean(links.website);
const hasDownload = Boolean(links.download);
const searchText = normalizeSearchText(project.searchText);
const updatedAt = project.updatedAt ? String(Date.parse(project.updatedAt)) : "0";
const commitLabel = formatCommitFrequency(stats?.commitsLast90Days, stats?.commitsLast90DaysCapped);
---

<article
  class="project-card"
  data-project-card
  data-category={project.category}
  data-status={maintenance.status}
  data-search={searchText}
  data-updated={updatedAt}
  data-stars={stats?.stars ?? 0}
  data-quality={audit?.score ?? -1}
  data-code-quality={audit?.codeQuality?.score ?? -1}
  data-name={normalizeSearchText(project.name)}
  data-archived={String(stats?.archived ?? false)}
  data-slug={project.slug}
>
  <div class="project-card__bar">
    <span class="project-card__path">~/{project.category}/{project.slug}</span>
    <span
      class="project-card__status"
      style={`--status-color: var(--status-${maintenance.status})`}
      title={maintenance.description}
    >
      <span class={`status-dot status-dot--${maintenance.status}`} aria-hidden="true"></span>
      {maintenance.label}
    </span>
  </div>

  <div class="project-card__body">
    <div class="project-card__top">
      <div class="project-card__identity">
        <ProjectAvatar project={project} />

        <h3 class="project-card__title">
          <a href={primaryHref} target="_blank" rel="noopener noreferrer">{project.name}</a>
          {project.featured && (
            <span class="project-card__featured" title="编辑推荐">
              <Icon name="lucide:sparkles" aria-hidden="true" />
              <span class="sr-only">编辑推荐</span>
            </span>
          )}
        </h3>
      </div>

      <div class="project-card__links">
        {hasWebsite && (
          <a
            class="card-action"
            href={links.website}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${project.name} 网站`}
            title="访问项目网站"
          >
            <Icon name="lucide:globe" aria-hidden="true" />
            网站
          </a>
        )}

        {hasDownload && (
          <a
            class="card-action"
            href={links.download}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${project.name} 下载`}
            title="前往下载"
          >
            <Icon name="lucide:download" aria-hidden="true" />
            下载
          </a>
        )}

        {project.repoUrl && (
          <a
            class="card-action card-action--icon"
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${project.name} 的 GitHub 仓库`}
            title="GitHub 仓库"
          >
            <Icon name="lucide:github" aria-hidden="true" />
          </a>
        )}
      </div>
    </div>

    <p class="project-card__description">{project.description}</p>

    <div class="project-card__meta">
      <a
        class="card-meta"
        href={`/categories/${categoryInfo.id}/`}
        aria-label={`查看${categoryInfo.label}分类`}
        title={`${categoryInfo.label}分类`}
      >
        <Icon name="lucide:folder" aria-hidden="true" />
        {categoryInfo.label}
      </a>

      {stats && (
        <a
          class="card-meta"
          href={project.repoUrl ?? primaryHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${project.name} 的 ${formatCompactNumber(stats.stars)} Stars`}
          title={`${formatCompactNumber(stats.stars)} Stars`}
        >
          <Icon name="lucide:star" aria-hidden="true" />
          {formatCompactNumber(stats.stars)}
        </a>
      )}

      {audit && <AuditBadge audit={audit} slug={project.slug} projectName={project.name} />}
    </div>

    <div class="project-card__extras">
      <div class="project-card__signals">
        <span
          class="project-card__updated"
          title={`${maintenance.description} 最近更新：${formatDate(project.updatedAt)}`}
        >
          {project.updatedAt ? (
            <time datetime={project.updatedAt}>{formatDate(project.updatedAt)}</time>
          ) : (
            <span>暂无数据</span>
          )}
        </span>

        {stats?.language && (
          <span class="signal">
            <Icon name="lucide:code-xml" aria-hidden="true" />
            {stats.language}
          </span>
        )}

        {commitLabel && (
          <span class="signal" title="最近 90 天默认分支上的提交数量">
            <Icon name="lucide:git-commit-horizontal" aria-hidden="true" />
            {commitLabel}
          </span>
        )}
      </div>

      <ul class="project-card__tags" aria-label="项目标签">
        {project.tags.map((tag) => (
          <li>
            <button
              class="tag-button"
              type="button"
              data-search-tag={tag}
              title={`按标签搜索：${tag}`}
            >
              {tag}
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</article>
